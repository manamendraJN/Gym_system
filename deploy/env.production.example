# Production environment for the Gym Management System.
# Copy to /srv/gym/.env (readable only by the service user: chmod 600) and replace EVERY value marked CHANGE.
# Never commit this file with real values.

# --- Core ---
DEBUG=False
# CHANGE: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-to-a-long-random-string
# CHANGE: your real host name(s), comma separated, no scheme
ALLOWED_HOSTS=gym.example.com
# CHANGE: the https:// origin(s) users open in the browser (needed for form submissions over HTTPS)
CSRF_TRUSTED_ORIGINS=https://gym.example.com
GYM_NAME=Your Gym Name
TIME_ZONE=Asia/Colombo

# --- HTTPS (leave the defaults; only set SECURE_SSL_REDIRECT=False if your proxy already redirects and
#     does not forward the X-Forwarded-Proto header) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_PRELOAD=False
# Set True only when nginx (or another proxy you control) OVERWRITES X-Forwarded-For
USE_X_FORWARDED_FOR=True

# --- Database (PostgreSQL) ---
DB_ENGINE=postgresql
DB_NAME=gym_system
DB_USER=gym
DB_PASSWORD=CHANGE-ME
DB_HOST=127.0.0.1
DB_PORT=5432
# DB_SSLMODE=require        # when the database is on another host

# --- Shared cache for login throttling (recommended with more than one worker) ---
# REDIS_URL=redis://127.0.0.1:6379/1

# --- E-mail (password reset, notifications). Leave EMAIL_BACKEND as console to send nothing. ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE-ME
EMAIL_HOST_PASSWORD=CHANGE-ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Your Gym <no-reply@gym.example.com>

# --- Optional modules ---
NUTRITION_ENABLED=False
INVENTORY_ENABLED=True

# --- Optional SMS / WhatsApp via Twilio (leave "none" to use in-app + e-mail only) ---
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# TWILIO_WEBHOOK_URL=https://gym.example.com/notifications/webhooks/twilio/

LOG_LEVEL=INFO
