# Copy to .env and adjust. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database: sqlite (local development) or postgresql (production)
DB_ENGINE=sqlite
DB_NAME=gym_system
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (password reset). Dev default prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Gym System <no-reply@example.com>

TIME_ZONE=Asia/Colombo

# Optional modules
NUTRITION_ENABLED=False
INVENTORY_ENABLED=True

# Optional external messaging (leave as "none" to use only the in-app notification centre)
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
DEFAULT_PHONE_COUNTRY_CODE=+94
TWILIO_WEBHOOK_URL=

# Optional Celery (otherwise run `python manage.py run_scheduled_notifications` from cron)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
GYM_NAME=IronForge Gym
